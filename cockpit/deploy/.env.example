# Konsole (Control Plane) — Vorlage für `.env` neben der Compose-Datei.
#
#   cp .env.example .env && $EDITOR .env && docker compose up -d
#
# Referenz: docs/runbooks/install-cockpit.md, console-listener.md,
# kunden-onboarding.md. Was hier fehlt, fehlt spätestens beim ersten Kunden —
# und dann mitten im Termin.

# --- Wo die Konsole hört (ADR-0015 D1) ---------------------------------------
# Die MANAGEMENT-Adresse, nicht 0.0.0.0. Das ist die Trennlinie: der Port
# existiert im Internet gar nicht. Die API weigert sich zu starten, wenn hier
# eine Wildcard steht.
COCKPIT_BIND_ADDRESS=10.0.0.5
COCKPIT_HOSTNAME=console.mgmt.vitabrevis.ch
# Öffentlich erreichbar, TCP 46200: hier klopfen die Agenten aus den
# Kundennetzen an (ADR-0014). Kein Rückfall auf 443 (E11).
COCKPIT_CONNECTOR_HOSTNAME=connect.vitabrevis.ch

# --- Geheimnisse -------------------------------------------------------------
# Zwei verschiedene Marker, zwingend ungleich: sie unterscheiden die beiden
# Listener. Je: openssl rand -hex 32
COCKPIT_MANAGEMENT_MARKER=
COCKPIT_CONNECTOR_MARKER=
# Notzugang in eine frisch ausgerollte Konsole, in der noch kein Operator
# eingetragen ist. Danach der Weg, den man nicht mehr braucht — er verfällt
# aber nicht von selbst. openssl rand -hex 32
COCKPIT_BOOTSTRAP_TOKEN=
# Damit sind die TOTP-Geheimnisse der Operatoren verschlüsselt (ADR-0020 D2).
# Ein Wechsel verlangt, dass jeder Operator seinen zweiten Faktor neu
# einrichtet — es gibt keinen Weg ohne Zutun der Personen.
# openssl rand -base64 48
COCKPIT_SECRET_KEY=

# --- Bereitstellung (ADR-0013 D2) --------------------------------------------
# Verwaltungszugang zum Magister-Cluster: damit legt die Konsole Rolle und
# Schema an. Braucht CREATEROLE und CREATE auf der Zieldatenbank — nicht
# Superuser.
COCKPIT_TENANT_ADMIN_DSN=postgresql+asyncpg://cockpit_admin:<pw>@10.0.0.6:5432/magister
# Das Alembic-Verzeichnis der Datenebene, im Container sichtbar. Ohne das
# scheitert der Migrationsschritt und der Kunde bleibt auf `provisioning`.
COCKPIT_MAGISTER_API_DIR=/opt/magister/apps/api
# Revision, die ein frisch bereitgestelltes Schema tragen soll, und der Wert,
# gegen den die Meldung der Datenebene geprüft wird (ADR-0021 D2).
COCKPIT_EXPECTED_SCHEMA_VERSION=

# --- Sicherung und Export (ADR-0016) -----------------------------------------
# Der öffentliche age-Empfänger. Ohne ihn gibt es keine Sicherung — eine
# unverschlüsselte darf es nicht geben (harte Regel).
COCKPIT_BACKUP_AGE_RECIPIENT=age1...
# Pfade, die als Volume eingehängt werden (siehe docker-compose.yml).
COCKPIT_BACKUP_SHARE_ROOT=/var/backups/magister
COCKPIT_EXPORT_ROOT=/var/lib/magister/exports

# --- Dateien, die daneben liegen müssen --------------------------------------
# ./certs/platform-ca.pem        Root + Intermediate "Operator" (Trust Pool)
# ./certs/console.pem            Serverzertifikat für COCKPIT_HOSTNAME
# ./certs/console-key.pem        privater Schlüssel dazu, 0600
# ./certs/connector-int.pem      Intermediate "Connector" (stellt Agenten aus)
# ./certs/connector-int-key.pem  privater Schlüssel dazu, 0600
# ./certs/operator-signing.pem   Ed25519-Schlüssel für Einlösescheine (ADR-0019)
#
# Ein Wildcard-Zertifikat gilt für GENAU EINE Ebene: `*.vitabrevis.ch` deckt
# `connect.vitabrevis.ch` ab, aber nicht `console.mgmt.vitabrevis.ch`. Dafür
# braucht es `*.mgmt.vitabrevis.ch` — als zweites Wildcard oder als SAN.
