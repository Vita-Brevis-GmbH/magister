# AD-Zugang des Agenten. Rechte 0600, Eigentümer das Dienstkonto.
#
# Diese Werte kommen vom Kunden und NIE von der Plattform: das Dienstkonto ist
# das, dessen Rechte am Ende zählen, und wer es setzt, bestimmt die Grenze.
MAGISTER_AD_DCS=["dc01.gemeinde.local","dc02.gemeinde.local"]
MAGISTER_AD_BASE_DN=DC=gemeinde,DC=local
MAGISTER_AD_BIND_DN=CN=svc-magister,OU=Dienstkonten,DC=gemeinde,DC=local
MAGISTER_AD_BIND_PASSWORD=
# LDAPS auf 636 mit sealed+signed bind — Plain-LDAP ist nirgends eine Option.
MAGISTER_AD_USE_LDAPS=1
MAGISTER_AD_CA_BUNDLE=/etc/magister-connector/ad-ca.pem
