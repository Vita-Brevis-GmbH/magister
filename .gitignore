# Die Entwicklungsumgebung aus scripts/dev-umgebung.sh. Darin liegen echte
# Geheimnisse (Rollenpasswörter, Kundenschlüssel, private Zertifikatsschlüssel)
# und Kundendumps — nichts davon gehört je in ein Repository, auch nicht als
# Testwert: ein Beispielschlüssel im Verlauf ist ein Schlüssel, den jemand
# irgendwann produktiv einsetzt.
/dev/

