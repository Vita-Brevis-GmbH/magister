#!/usr/bin/env python3
"""Magister CLI — small ops tool for things you can't (yet) do via the API.

Subcommands:
    hash-password    — prompt for a password and print its argon2id hash
                       (used to seed MAGISTER_LOCAL_ADMIN_PASSWORD_HASH)
    seed-demo        — populate the DB with a small demo data set so an
                       empty deployment can show the full UI without
                       waiting for an AD-sync. Wraps
                       ``python -m magister_api.cli.seed_demo``.
    tenants          — the tenant registry (ADR-0013): ``list`` shows it,
                       ``migrate`` runs ``alembic upgrade head`` per tenant —
                       a pre-migration dump first, the canary before the rest,
                       and each schema migrated with the tenant's own login
                       role so the tables end up owned by it.
    local-admin      — the local break-glass account. Currently one action:
                       ``totp-reset`` clears the second factor (ADR-0015 D2),
                       ``--new-recovery-codes`` only reissues the codes, and
                       ``--disable`` closes the account. On-prem equivalent of
                       the console's four interventions.

The CLI needs the API venv so SQLAlchemy + argon2-cffi + magister_api
are importable. From a repo checkout:

    cd apps/api
    uv run ../../scripts/magister-cli hash-password
    uv run ../../scripts/magister-cli seed-demo

Inside the production Docker image the seed subcommand is reachable as
``python -m magister_api.cli.seed_demo`` directly (no wrapper needed).
"""

from __future__ import annotations

import argparse
import getpass
import sys


def cmd_hash_password(args: argparse.Namespace) -> int:
    try:
        from magister_api.auth.passwords import hash_password
    except ImportError:
        sys.stderr.write(
            "magister_api is not importable — run inside apps/api's venv:\n"
            "  cd apps/api && uv run ../../scripts/magister-cli hash-password\n"
        )
        return 2

    if args.plain:
        sys.stderr.write("Password: ")
        sys.stderr.flush()
        password = sys.stdin.readline().rstrip("\n")
    else:
        password = getpass.getpass("Password: ")
        confirm = getpass.getpass("Confirm:  ")
        if password != confirm:
            sys.stderr.write("Passwords do not match.\n")
            return 1

    if len(password) < 12:
        sys.stderr.write(
            "Refusing to hash a password under 12 characters — "
            "set a stronger one for an admin break-glass account.\n"
        )
        return 1

    sys.stdout.write(hash_password(password) + "\n")
    return 0


def cmd_seed_demo(args: argparse.Namespace) -> int:
    try:
        from magister_api.cli.seed_demo import main as seed_main
    except ImportError:
        sys.stderr.write(
            "magister_api is not importable — run inside apps/api's venv:\n"
            "  cd apps/api && uv run ../../scripts/magister-cli seed-demo\n"
        )
        return 2

    forwarded: list[str] = []
    if args.force:
        forwarded.append("--force")
    return seed_main(forwarded)


def cmd_local_admin_totp_reset(args: argparse.Namespace) -> int:
    try:
        from magister_api.cli.local_admin_totp import main as totp_main
    except ImportError:
        sys.stderr.write(
            "magister_api is not importable — run inside apps/api's venv:\n"
            "  cd apps/api && uv run ../../scripts/magister-cli local-admin totp-reset\n"
        )
        return 2

    forwarded: list[str] = []
    if args.new_recovery_codes:
        forwarded.append("--new-recovery-codes")
    if args.disable:
        forwarded.append("--disable")
    if args.reason:
        forwarded += ["--reason", args.reason]
    return totp_main(forwarded)


def main() -> int:
    parser = argparse.ArgumentParser(prog="magister-cli", description=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)

    hp = sub.add_parser(
        "hash-password",
        help="Read a password and print its argon2id hash for "
        "MAGISTER_LOCAL_ADMIN_PASSWORD_HASH.",
    )
    hp.add_argument(
        "--plain",
        action="store_true",
        help="Read from stdin without prompting (e.g. for piping). The "
        "password is NOT echoed back.",
    )
    hp.set_defaults(func=cmd_hash_password)

    sd = sub.add_parser(
        "seed-demo",
        help="Populate the DB with a small demo data set (1 school, "
        "3 teachers, 12 students, 2 classes with KL + memberships).",
    )
    sd.add_argument(
        "--force",
        action="store_true",
        help="Seed even if the DB already contains classes. Use with care.",
    )
    sd.set_defaults(func=cmd_seed_demo)

    la = sub.add_parser("local-admin", help="Local break-glass account actions.")
    la_sub = la.add_subparsers(dest="local_admin_cmd", required=True)
    tr = la_sub.add_parser(
        "totp-reset",
        help="Reset the second factor of the local account (ADR-0015 D2). Without "
        "options the factor is cleared and re-enrolled at the next sign-in.",
    )
    tr_group = tr.add_mutually_exclusive_group()
    tr_group.add_argument(
        "--new-recovery-codes",
        action="store_true",
        help="Only reissue the recovery codes; the secret is left alone.",
    )
    tr_group.add_argument(
        "--disable",
        action="store_true",
        help="Disable the account. Closes the break-glass path without weakening anything.",
    )
    tr.add_argument("--reason", default="", help="Reason or ticket number for the audit trail.")
    tr.set_defaults(func=cmd_local_admin_totp_reset)

    # Mandanten-Werkzeug (ADR-0013). Der Import liegt hier drin, damit die
    # anderen Subcommands weiter funktionieren, wenn magister_api nicht
    # importierbar ist — der Fall, den cmd_hash_password oben abfängt.
    try:
        from magister_api.cli.tenants import add_parser as add_tenants_parser
    except ImportError:
        pass
    else:
        add_tenants_parser(sub)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
